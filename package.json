{
  "name": "nestjs-raft-leader-election",
  "version": "0.0.4",
  "description": "Leader election module for NestJS",
  "author": "matthiashampel13@gmail.com",
  "license": "MIT",
  "keywords": ["NestJS", "Leader Election", "Raft"],
  "engines": {
    "node": ">= 24",
    "npm": ">= 11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthias-hampel/nestjs-raft-leader-election.git"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "files": ["dist"],
  "scripts": {
    "build": "nest build",
    "format": "biome format --write",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "biome lint --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "11.1.20",
    "@nestjs/core": "11.1.20",
    "@nestjs/platform-express": "11.1.20",
    "@nestjs/schedule": "6.1.3",
    "date-fns": "4.1.0",
    "redis": "5.12.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.21",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.20",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.7.0",
    "@types/supertest": "7.2.0",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.6.0",
    "jest": "30.4.2",
    "prettier": "3.8.3",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.9",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
